#!/bin/sh
set -e

usage () {
    cat <<'EOF'
usage: git modified [-miuqh] [<commit>] [-- <pathspec>...]

Prints list of files that are locally modified (and exist).  The index is not 
considered, unless the -i flag is provided.

If a commit is provided, opens all files that locally exist that have been 
changed in that commit.

Pathspecs after '--' restrict the output to matching files.

This script is ideal for passing all locally modified files into your editor, like:
    $ vim $(git modified)

Options:
-m    Modified files only (excludes untracked files)
-i    Consider the index, too
-u    Print only files that are unmerged (files with conflicts)
-q    Be quiet, only return with 0 exit code when files are modified
-h    Show this help
EOF
}

modified=0
index=0
unmerged=0
quiet=0
commit=""

# Parse flags, optional commit, and `--` pathspec separator manually.
# getopts can't be used here because it consumes `--` and advances OPTIND
# past it, which would prevent us from distinguishing
# `git modified <commit>` from `git modified -- <pathspec>`.
while [ $# -gt 0 ]; do
    case "$1" in
        --)
            shift
            break
            ;;
        -h)
            usage
            exit 0
            ;;
        -*)
            opts="${1#-}"
            while [ -n "$opts" ]; do
                c="${opts%"${opts#?}"}"
                opts="${opts#?}"
                case "$c" in
                    m) modified=1;;
                    i) index=1;;
                    u) unmerged=1;;
                    q) quiet=1;;
                    h) usage; exit 0;;
                    *) echo "Unknown option: -$c" >&2; exit 2;;
                esac
            done
            shift
            ;;
        *)
            if [ -n "$commit" ]; then
                echo "Unexpected argument: $1 (use '--' to pass pathspecs)" >&2
                exit 2
            fi
            commit="$1"
            shift
            ;;
    esac
done
# $@ now holds zero or more pathspecs

if [ -n "$commit" ]; then
    if ! git rev-parse --verify --quiet "$commit^{commit}" >/dev/null 2>&1; then
        echo "Not a valid commit: $commit" >&2
        if [ -e "$commit" ]; then
            echo "Did you mean: git modified -- $commit" >&2
        fi
        exit 2
    fi
    if [ $modified -eq 1 ] || [ $index -eq 1 ] || [ $unmerged -eq 1 ]; then
        echo "Flags -m/-i/-u cannot be combined with a commit." >&2
        exit 2
    fi
fi

#
# git status cheat sheet:
#
# X          Y     Meaning
# -------------------------------------------------
#           [MD]   not updated
# M        [ MD]   updated in index
# A        [ MD]   added to index
# D         [ M]   deleted from index
# R        [ MD]   renamed in index
# C        [ MD]   copied in index
# [MARC]           index and work tree matches
# [ MARC]     M    work tree changed since index
# [ MARC]     D    deleted in work tree
# -------------------------------------------------
# D           D    unmerged, both deleted
# A           U    unmerged, added by us
# U           D    unmerged, deleted by them
# U           A    unmerged, added by them
# D           U    unmerged, deleted by us
# A           A    unmerged, both added
# U           U    unmerged, both modified
# -------------------------------------------------
# ?           ?    untracked
# !           !    ignored
# -------------------------------------------------

# With -z, git separates paths with NUL bytes and never quotes them. Without
# it, git puts a path that contains a space, a double quote, a backslash or a
# control character in C-style quotes, and shows a rename as "old -> new",
# neither of which can be undone reliably in sh.
status () {
    if [ $# -gt 0 ]; then
        git status --porcelain -z -- "$@" | nul_to_lines
    else
        git status --porcelain -z | nul_to_lines
    fi
}

# Turns NUL-terminated records into lines. A newline inside a name becomes a
# \001 byte first, so every line is exactly one record, and a name with a
# newline in it cannot be mistaken for the start of another record.
nul_to_lines () {
    tr '\n\0' '\001\n'
}

soh="$(printf '\001')"

# Reads `git status --porcelain -z` records, one per line, and prints the path
# of each one the flags select.
select_paths () {
    source_next=0
    while IFS= read -r record; do
        if [ $source_next -eq 1 ]; then
            # The original path of a rename or copy: only the new path is listed
            source_next=0
            continue
        fi
        xy="${record%"${record#??}"}"
        case "$xy" in
            [RC]?|?[RC]) source_next=1;;
        esac
        # Deleted files don't exist, so they are never listed
        case "$xy" in
            ?D|"D ") continue;;
        esac
        if [ $unmerged -eq 1 ]; then
            case "$xy" in
                U?|?U) ;;
                *) continue;;
            esac
        elif [ $index -eq 1 ]; then
            :
        elif [ $modified -eq 1 ]; then
            case "$xy" in
                ?M) ;;
                *) continue;;
            esac
        else
            # Changed in the work tree, or untracked
            case "$xy" in
                ?" ") continue;;
            esac
        fi
        printf '%s\n' "${record#???}"
    done
}

# Names with a newline cannot be printed one per line, so they are left out.
skip_newline_names () {
    while IFS= read -r f; do
        case "$f" in
            *"$soh"*)
                if [ $quiet -eq 0 ]; then
                    echo "git modified: skipping a filename that contains a newline" >&2
                fi
                ;;
            *)
                printf '%s\n' "$f"
                ;;
        esac
    done
}

make_relative () {
    while IFS= read -r f; do
        git relative-path "$f"
    done
}

fail_if_empty () {
    empty=1
    while IFS= read -r line; do
        if [ $quiet -eq 0 ]; then
            printf '%s\n' "$line"
        fi
        empty=0
    done
    test $empty -eq 0
}

if [ -z "$commit" ]; then
    status "$@" | select_paths | skip_newline_names | make_relative | fail_if_empty
else
    # --root so the initial commit lists its files, -M so a rename yields only
    # the destination path.
    git diff-tree -z -r -M --root --no-commit-id --name-only "$commit" -- "$@" | nul_to_lines | skip_newline_names | make_relative | while IFS= read -r f; do
        if [ -f "$f" ]; then
            printf '%s\n' "$f"
        fi
    done | fail_if_empty
fi
